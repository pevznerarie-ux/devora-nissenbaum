# PedagoOS — variables d'environnement (aucune valeur réelle dans le dépôt).
# Client (seules variables exposées au navigateur — docs/architecture.md §9)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SENTRY_AUTH_TOKEN=

# Tests RLS (stack Supabase locale : `pnpm db:start`)
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Visual Intelligence Engine (ADR-0016) — serveur uniquement, aucune valeur réelle
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Wikimedia : domaine public, aucune clé requise
GEMINI_API_KEY=
# Feature flags visuels (1/0/true/false ; défaut : voir feature-flags.ts)
FEATURE_STOCK_PHOTO_SEARCH=
FEATURE_AI_IMAGE_GENERATION=
FEATURE_WIKIMEDIA_SOURCES=
FEATURE_VISUAL_SEMANTIC_SEARCH=
FEATURE_RECURRING_CHARACTERS=
